# ─── Database ────────────────────────────────────────────────────────────────
# Must be a Postgres instance with the pgvector extension available.
# `pnpm db:up` starts a compatible container at this URL.
DATABASE_URL="postgresql://chatforge:chatforge@localhost:5432/chatforge?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Optional OAuth providers — leave blank to disable the button.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── LLM ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public origin. Used in embed snippets, share page URLs, and CORS checks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB="10"
MAX_MESSAGE_LENGTH="4000"
MAX_HISTORY_MESSAGES="20"
RATE_LIMIT_PER_MINUTE="30"
